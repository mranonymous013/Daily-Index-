rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserSettings(data, userId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.dailyBudget is number &&
             data.dailyBudget >= 0 && data.dailyBudget <= 100000000 &&
             data.currencySymbol is string &&
             data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
             data.defaultsSeeded is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHabit(data, userId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 && data.name.size() <= 60 &&
             data.icon is string &&
             data.icon.size() >= 1 && data.icon.size() <= 16 &&
             data.completedDates is list &&
             data.completedDates.size() <= 1500 &&
             (data.completedDates.size() == 0 || data.completedDates[0] is string) &&
             data.sortOrder is int &&
             data.sortOrder >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExpense(data, userId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             isValidDateKey(data.date) &&
             data.title is string &&
             data.title.size() >= 1 && data.title.size() <= 60 &&
             data.amount is number &&
             data.amount > 0 && data.amount <= 100000000 &&
             data.category is string &&
             data.category.size() >= 1 && data.category.size() <= 24 &&
             data.category in ['Food', 'Transport', 'Groceries', 'Bills', 'Shopping', 'Health', 'Other'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- USER SETTINGS COLLECTION ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'dailyBudget', 'currencySymbol', 'defaultsSeeded', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'dailyBudget', 'currencySymbol', 'defaultsSeeded', 'createdAt', 'updatedAt']) &&
                       isValidUserSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Update daily budget / currency
                         incoming().diff(existing()).affectedKeys().hasOnly(['dailyBudget', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['dailyBudget', 'currencySymbol', 'updatedAt']) ||
                         // Action: Mark starter habits seeded
                         incoming().diff(existing()).affectedKeys().hasOnly(['defaultsSeeded', 'updatedAt']) ||
                         // Action: Restore backup settings
                         incoming().diff(existing()).affectedKeys().hasOnly(['dailyBudget', 'defaultsSeeded', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- HABITS SUBCOLLECTION ---
      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(habitId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(habitId) &&
                         incoming().keys().hasAll(['userId', 'name', 'icon', 'completedDates', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'icon', 'completedDates', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         isValidHabit(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(habitId) &&
                         isValidHabit(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Toggle completion date or clear completion history
                           incoming().diff(existing()).affectedKeys().hasOnly(['completedDates', 'updatedAt']) ||
                           // Action: Edit habit title or icon
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(habitId);
      }

      // --- EXPENSES SUBCOLLECTION ---
      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         incoming().keys().hasAll(['userId', 'date', 'title', 'amount', 'category', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'date', 'title', 'amount', 'category', 'createdAt', 'updatedAt']) &&
                         isValidExpense(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         isValidExpense(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         // Action: Edit expense details
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'category', 'date', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(expenseId);
      }
    }
  }
}
